			local EquippedList = {}

			pcall(function()
				local EquippedData = Library.PetCmds.GetEquipped(Player)
				if EquippedData then
					for _, PetObj in ipairs(EquippedData) do
						table.insert(EquippedList, PetObj.uid)
					end
				end
			end)

			if #EquippedList == 0 then
				UpdateLabel(Labels.EnchantStatus, "Nenhum pet equipado!")
				task.wait(1)
			else
				local IncompletePets = 0

				for _, PetUid in ipairs(EquippedList) do
					if not Settings.Enchant.Enabled then break end

					local PetData = nil
					local SaveData = Library.Save.Get()
					if SaveData and SaveData.Pets then
						for _, Record in pairs(SaveData.Pets) do
							if Record.uid == PetUid then
								PetData = Record
								break
							end
						end
					end
					if not PetData then
						PetData = Library.PetCmds.Get(PetUid)
					end

