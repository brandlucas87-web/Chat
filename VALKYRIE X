end

local HoverboardManager = {}
do
	local FILE_NAME = "LastHoverboard.txt"
	local GAMEPASS_ID = 18674298
	local Initialized = false
	local OriginalOwns = Library.Gamepasses.Owns
	local OriginalMessage = Library.Message.New

	local ValidNames = {}
	for Name, Data in pairs(Library.Directory.Hoverboards) do
		if type(Data) == "table" and Data.board then
			table.insert(ValidNames, Name)
		end
	end
	table.sort(ValidNames)

	local FallbackName = Library.Directory.Hoverboards["Original"] and "Original" or (ValidNames[1] or "Original")

	local function SaveState(Name)
		if writefile then
			pcall(writefile, FILE_NAME, Name)
		end
	end

	local function LoadState()
		if readfile then
			local Success, Result = pcall(readfile, FILE_NAME)
			if Success and Result then
				return Result
			end
		end
		return nil
	end

	function HoverboardManager.Initialize()
		if Initialized then return end
		Initialized = true

		Library.Gamepasses.Owns = function(ID, TargetPlayer)
			if Settings.Player.UnlockHoverboards and tostring(ID) == tostring(GAMEPASS_ID) then
				return true
			end
			return OriginalOwns(ID, TargetPlayer)
		end

		Library.Message.New = function(MessageText, ...)
			if Settings.Player.UnlockHoverboards and typeof(MessageText) == "string" then
				if string.find(string.lower(MessageText), "you don't own this hoverboard") then
					return
				end
			end
			return OriginalMessage(MessageText, ...)
		end

		local Container = Library.GUI.Hoverboards
		local ContentHolder = Container and Container.Container and Container.Container.Holder

		if ContentHolder then
			local function AttachListener(Button)
				if not Button:IsA("GuiButton") then return end
				Button.Activated:Connect(function()
					if not Settings.Player.UnlockHoverboards then return end
					local SelectedName = Button.Name
					if Library.Directory.Hoverboards[SelectedName] then
						local SaveData = Library.Save.Get()
						if SaveData then
							SaveData.EquippedHoverboard = SelectedName
							SaveState(SelectedName)
							Library.Signal.Fire("Stat Changed", "EquippedHoverboard")
						end
					end
				end)
			end

			for _, Item in ipairs(ContentHolder:GetChildren()) do
				AttachListener(Item)
			end

			ContentHolder.ChildAdded:Connect(function(NewItem)
				task.defer(function()
					AttachListener(NewItem)
				end)
			end)
		end

		task.spawn(function()
			while true do
				task.wait(2)
				if Settings.Player.UnlockHoverboards then
					local SaveData = Library.Save.Get()
					if SaveData then
						SaveData.Hoverboards = ValidNames
						if SaveData.EquippedHoverboard == "" or not Library.Directory.Hoverboards[SaveData.EquippedHoverboard] then
							local SavedName = LoadState()
							SaveData.EquippedHoverboard = (SavedName and Library.Directory.Hoverboards[SavedName]) and SavedName or FallbackName
							Library.Signal.Fire("Stat Changed", "EquippedHoverboard")
						else
							local SavedName = LoadState()
							if SaveData.EquippedHoverboard ~= SavedName then
								SaveState(SaveData.EquippedHoverboard)
							end
						end
					end
				end
			end
		end)
	end

	function HoverboardManager.SetEnabled(State)
		HoverboardManager.Initialize()
		local SaveData = Library.Save.Get()
		if SaveData and State then
			local SavedName = LoadState()
			local Target = (SavedName and Library.Directory.Hoverboards[SavedName]) and SavedName or FallbackName
			SaveData.EquippedHoverboard = Target
			SaveData.Hoverboards = ValidNames
			SaveState(Target)

			Library.Signal.Fire("Stat Changed", "Hoverboards")
			Library.Signal.Fire("Stat Changed", "EquippedHoverboard")
			Library.Signal.Fire("Stat Changed", "Gamepasses")
		end
	end
end

local CollectionManager = {}
do
	local VariantNames = {
		[1] = "Normal",
		[2] = "Golden",
		[3] = "Rainbow"
	}
	local TemporaryBlacklist = {}

	function CollectionManager.CanAffordEgg(EggName, WantTriple)
		if TemporaryBlacklist[EggName] and os.clock() < TemporaryBlacklist[EggName] then
			return false, false
		end
		local EggData = Library.Directory.Eggs[EggName]
		if not EggData then
			return true, WantTriple
		end
		local SaveData = Library.Save.Get()
		if not SaveData then
			return true, WantTriple
		end
		local CurrencyKey = EggData.currency or "Coins"
		local Balance = tonumber(SaveData[CurrencyKey])
		local SingleCost = tonumber(EggData.cost) or 0
		if not Balance or SingleCost <= 0 then
			return true, WantTriple
		end
		if Balance < SingleCost then
			return false, false
		end
		if WantTriple and Balance >= (SingleCost * 3) then
			return true, true
		end
		return true, false
	end

	function CollectionManager.BlacklistEgg(EggName, Duration)
		TemporaryBlacklist[EggName] = os.clock() + (Duration or 15)
	end

	function CollectionManager.GetStats()
		local SaveData = Library.Save.Get()
		if not (SaveData and SaveData.Collection) then
			return 0, 0, 0, 0, false
		end
		local AllCollectables = Library.Shared.GetAllCollectablePets()
		local TotalCollectable = 0
		for _, PetInfo in ipairs(AllCollectables) do
			local DirectoryData = Library.Directory.Pets[PetInfo.petId]
			if DirectoryData and DirectoryData.rarity ~= "Exclusive" and not PetInfo.isDarkMatter then
				TotalCollectable = TotalCollectable + 1
			end
		end

		local CollectedCount = #SaveData.Collection
		local Tier = SaveData.CollectionTier or 0
		local NextGoal = Library.Shared.PetCollectionTiers[Tier + 1]
		local CanRedeem = NextGoal and (CollectedCount >= NextGoal) or false
		return CollectedCount, TotalCollectable, Tier, NextGoal or 0, CanRedeem
	end

	function CollectionManager.GetNextMissingPet()
		local SaveData = Library.Save.Get()
		if not (SaveData and SaveData.Collection) then
			return nil, "error"
		end

		local AllCollectables = Library.Shared.GetAllCollectablePets()
		local CandidateList = {}
		for _, PetInfo in ipairs(AllCollectables) do
			local PetId = PetInfo.petId
			local DirectoryData = Library.Directory.Pets[PetId]
			if DirectoryData and DirectoryData.rarity ~= "Exclusive" and not PetInfo.isDarkMatter then
				local VariantNumber = 1
				if PetInfo.isGolden then
					VariantNumber = 2
				elseif PetInfo.isRainbow then
					VariantNumber = 3
				end

				local Key = tostring(PetId) .. "-" .. tostring(VariantNumber)
				local IsUnlocked = Library.Functions.SearchArray(SaveData.Collection, Key)
				if not IsUnlocked then
					local BaseEggName = Library.Shared.GetPetEgg(PetId)
					if BaseEggName then
						local TargetEgg = BaseEggName
						if VariantNumber == 2 or VariantNumber == 3 then
							local GoldenEggName = "Golden " .. BaseEggName
							if Library.Directory.Eggs[GoldenEggName] and not Library.Directory.Eggs[GoldenEggName].disabled then
								TargetEgg = GoldenEggName
							end
						end
						table.insert(CandidateList, {
							PetId = PetId,
							PetName = DirectoryData.name or tostring(PetId),
							VariantNumber = VariantNumber,
							VariantName = VariantNames[VariantNumber] or "Normal",
							TargetEgg = TargetEgg,
							BaseEgg = BaseEggName,
							Key = Key
						})
					end
				end
			end
		end

		if #CandidateList == 0 then
			return nil, "completed"
		end

		table.sort(CandidateList, function(A, B)
			if A.BaseEgg ~= B.BaseEgg then
				return A.BaseEgg < B.BaseEgg
			end
			if A.VariantNumber ~= B.VariantNumber then
				return A.VariantNumber < B.VariantNumber
			end
			local IdA = tonumber(A.PetId) or 0
			local IdB = tonumber(B.PetId) or 0
			return IdA < IdB
		end)

		local WantTriple = (Settings.Collection.Amount == 3)
		for _, Candidate in ipairs(CandidateList) do
			local CanAfford, UseTriple = CollectionManager.CanAffordEgg(Candidate.TargetEgg, WantTriple)
			if CanAfford then
				Candidate.UseTriple = UseTriple
				return Candidate, "ready"
			end
		end

		return CandidateList[1], "unaffordable"
	end

	function CollectionManager.RedeemReward()
		pcall(function()
			Library.Network.Invoke("Redeem Pet Collection")
		end)
	end
end

local CoinScanner = {}
do
	CoinsFolder.ChildRemoved:Connect(function(Object)
		Cache.Candies[Object] = nil
	end)

	function CoinScanner.IsCandyCane(InstanceObj)
		if not (InstanceObj and InstanceObj.Parent) then
			return false
		end

		local CachedState = Cache.Candies[InstanceObj]
		if CachedState ~= nil then
			return CachedState
		end

		local AttributeName = InstanceObj:GetAttribute("Name") or ""
		local LowerName = string.lower(AttributeName)

		if string.find(LowerName, "candy cane") or string.find(LowerName, "candycane") or LowerName == "candy canes" then
			Cache.Candies[InstanceObj] = true
			return true
		end

		for _, Child in ipairs(InstanceObj:GetChildren()) do
			local ChildName = string.lower(Child.Name)
			if string.find(ChildName, "candycane") or string.find(ChildName, "candy cane") then
				Cache.Candies[InstanceObj] = true
				return true
			end
		end

		Cache.Candies[InstanceObj] = false
		return false
	end

	function CoinScanner.CountCandies()
		local CurrentTime = os.clock()
		if CurrentTime - Cache.LastCandyTime < 2 then
			return Cache.LastCandyCount
		end

		Cache.LastCandyTime = CurrentTime
		local Counter = 0

		for _, Coin in ipairs(CoinsFolder:GetChildren()) do
			if CoinScanner.IsCandyCane(Coin) then
				Counter = Counter + 1
			end
		end

		Cache.LastCandyCount = Counter
		return Counter
	end

	function CoinScanner.GetAreaCoins(AreaMetadata, Radius)
		local Range = Radius or 190
		local Result = {}
		local CenterPosition = AreaMetadata.position

		for _, Coin in ipairs(CoinsFolder:GetChildren()) do
			local PositionPart = Coin:FindFirstChild("POS")
			local CoinZone = Coin:GetAttribute("Area")

			if CoinZone and string.lower(CoinZone) == string.lower(AreaMetadata.name) then
				table.insert(Result, Coin)
			elseif PositionPart and (PositionPart.Position - CenterPosition).Magnitude <= Range then
				table.insert(Result, Coin)
			end
		end

		return Result
	end
end

local PetOperations = {}
do
	function PetOperations.GetEquippedIds()
		local IdList = {}
		for _, Model in ipairs(PetsFolder:GetChildren()) do
			local OwnerName = Model:GetAttribute("Owner")
			local PetIdentifier = Model:GetAttribute("ID") or Model.Name
			if OwnerName == Player.Name and PetIdentifier then
				table.insert(IdList, PetIdentifier)
			end
		end

		if #IdList == 0 then
			pcall(function()
				local EquippedPets = Library.PetCmds.GetEquipped(Player)
				if EquippedPets then
					for _, PetObj in ipairs(EquippedPets) do
						table.insert(IdList, PetObj.uid)
					end
				end
			end)
		end

		return IdList
	end

	function PetOperations.AssignPets(TargetCoin, PetsToAssign)
		if not (TargetCoin and TargetCoin.Parent and #PetsToAssign > 0) then
			return
		end

		local CoinIdentifier = TargetCoin:GetAttribute("ID") or TargetCoin.Name
		pcall(function()
			Library.Network.Invoke("Join Coin", CoinIdentifier, PetsToAssign)
			for _, PetId in ipairs(PetsToAssign) do
				Library.Network.Fire("Farm Coin", CoinIdentifier, PetId)
			end
			Library.Signal.Fire("Select Coin", TargetCoin)
		end)
	end

	function PetOperations.ParsePowers(PowersArray)
		local Map = {}
		if PowersArray then
			for _, Item in ipairs(PowersArray) do
				local PowerName = Item[1]
				local PowerTier = tonumber(Item[2]) or 1
				if PowerName then
					Map[PowerName] = PowerTier
				end
			end
		end
		return Map
	end

	function PetOperations.CheckEnchant(PetRecord, TargetEnchant)
		if not (PetRecord and PetRecord.powers) then return false end
		local PowerMap = PetOperations.ParsePowers(PetRecord.powers)
		local Filter = string.lower(TargetEnchant)
		local RomanNumerals = { "I", "II", "III", "IV", "V" }

		for Name, Tier in pairs(PowerMap) do
			local FormattedTitle = Name .. " " .. (RomanNumerals[Tier] or tostring(Tier))
			if string.lower(FormattedTitle) == Filter or string.lower(Name) == Filter then
				return true
			end

			local CleanName = TargetEnchant:gsub("%s+[IVX]+$", ""):gsub("%s+%d+$", "")
			local ExtractedTier = tonumber(TargetEnchant:match("%s+(%d+)$"))
			if not ExtractedTier then
				local RomanPattern = TargetEnchant:match("%s+([IVX]+)$")
				if RomanPattern then
					for Index, Value in ipairs(RomanNumerals) do
						if Value == RomanPattern then
							ExtractedTier = Index
							break
						end
					end
				end
			end

			if CleanName and ExtractedTier then
				if string.lower(Name) == string.lower(CleanName) and Tier >= ExtractedTier then
					return true
				end
			end
		end

		return false
	end
end

local DirectoryScanner = {}
do
	function DirectoryScanner.GetAvailableEggs()
		local EggRegistry, UniqueTracker = {}, {}
		local EggsAssetFolder = ReplicatedStorage:FindFirstChild("Game") and ReplicatedStorage.Game:FindFirstChild("Eggs")

		if EggsAssetFolder then
			for _, Item in ipairs(EggsAssetFolder:GetDescendants()) do
				if Item:IsA("ModuleScript") and not UniqueTracker[Item.Name] then
					UniqueTracker[Item.Name] = true
					table.insert(EggRegistry, Item.Name)
				end
			end
		end

		pcall(function()
			if Library.Directory and Library.Directory.Eggs then
				for RegistryName, _ in pairs(Library.Directory.Eggs) do
					if not UniqueTracker[RegistryName] then
						UniqueTracker[RegistryName] = true
						table.insert(EggRegistry, RegistryName)
					end
				end
			end
		end)

		table.sort(EggRegistry)
		return #EggRegistry > 0 and EggRegistry or { "Gingerbread Egg", "Golden Gingerbread Egg", "Christmas Tree Egg", "Golden Christmas Tree Egg" }
	end

	function DirectoryScanner.GetOrderedZones()
		local SortedAreas = {}
		local WorkspaceMap = workspace:FindFirstChild("__MAP")
		local FastTravelFolder = WorkspaceMap and WorkspaceMap:FindFirstChild("Teleports")
		local PhysicalAreas = WorkspaceMap and WorkspaceMap:FindFirstChild("Areas")

		if FastTravelFolder and #FastTravelFolder:GetChildren() > 0 then
			local Buffer = {}
			for _, Marker in ipairs(FastTravelFolder:GetChildren()) do
				table.insert(Buffer, { name = Marker.Name, position = Marker.Position, sortKey = Marker.Position.X })
			end
			table.sort(Buffer, function(A, B) return A.sortKey > B.sortKey end)
			for _, Entry in ipairs(Buffer) do table.insert(SortedAreas, Entry) end
		elseif PhysicalAreas and #PhysicalAreas:GetChildren() > 0 then
			for _, Zone in ipairs(PhysicalAreas:GetChildren()) do
				local Anchor = Zone:FindFirstChildWhichIsA("BasePart")
				if Anchor then
					table.insert(SortedAreas, { name = Zone.Name, position = Anchor.Position, sortKey = Anchor.Position.X })
				end
			end
			table.sort(SortedAreas, function(A, B) return A.sortKey > B.sortKey end)
		end

		return SortedAreas
	end

	function DirectoryScanner.GetZoneNames()
		local ZoneNames = {}
		for _, Entry in ipairs(DirectoryScanner.GetOrderedZones()) do
			table.insert(ZoneNames, Entry.name)
		end
		return #ZoneNames > 0 and ZoneNames or { "Town", "Forest", "Beach", "Mine", "Winter", "Glacier", "Desert", "Volcano", "Cave" }
	end

	function DirectoryScanner.GetEnchantList()
		local Enchants, Visited = {}, {}

		pcall(function()
			local PowersDirectory = ReplicatedStorage:FindFirstChild("Framework")
				and ReplicatedStorage.Framework:FindFirstChild("Shared")
				and ReplicatedStorage.Framework.Shared:FindFirstChild("1 | Directory")
				and ReplicatedStorage.Framework.Shared["1 | Directory"]:FindFirstChild("Powers")

			if PowersDirectory then
				for _, ModuleNode in ipairs(PowersDirectory:GetChildren()) do
					if ModuleNode:IsA("ModuleScript") then
						local Success, RawData = pcall(require, ModuleNode)
						if Success and type(RawData) == "table" then
							for CategoryName, CategoryContent in pairs(RawData) do
								if type(CategoryContent) == "table" and CategoryContent.canDrop then
									if CategoryContent.tiers and #CategoryContent.tiers > 0 then
										for _, TierEntry in ipairs(CategoryContent.tiers) do
											if TierEntry.title and not Visited[TierEntry.title] then
												Visited[TierEntry.title] = true
												table.insert(Enchants, TierEntry.title)
											end
										end
									elseif not Visited[CategoryName] then
										Visited[CategoryName] = true
										table.insert(Enchants, CategoryName)
									end
								end
							end
						end
					end
				end
			end
		end)

		pcall(function()
			if Library.Directory and Library.Directory.Powers then
				for PowerKey, PowerAttributes in pairs(Library.Directory.Powers) do
					if type(PowerAttributes) == "table" and PowerAttributes.canDrop then
						if PowerAttributes.tiers and #PowerAttributes.tiers > 0 then
							for _, SubTier in ipairs(PowerAttributes.tiers) do
								if SubTier.title and not Visited[SubTier.title] then
									Visited[SubTier.title] = true
									table.insert(Enchants, SubTier.title)
								end
							end
						elseif not Visited[PowerKey] then
							Visited[PowerKey] = true
							table.insert(Enchants, PowerKey)
						end
					end
				end
			end
		end)

		table.sort(Enchants)
		return #Enchants > 0 and Enchants or { "Royalty", "Strength V", "Diamonds V", "Coins V", "Glittering", "Teamwork", "Charm", "Magnet" }
	end
end

