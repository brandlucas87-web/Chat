task.spawn(function()
	while true do
		task.wait(0.5)

		if not Settings.CandyFarm.Enabled then
			task.wait(0.5)
			continue
		end

		if not Library.WorldCmds.HasLoaded() then
			task.wait(1)
			continue
		end

		local CurrentWorldIdentifier = Library.WorldCmds.Get() or ""
		local OrderedZones = DirectoryScanner.GetOrderedZones()
		if #OrderedZones == 0 then
			task.wait(2)
			continue
		end

		for ZoneIndex, ZoneData in ipairs(OrderedZones) do
			if not Settings.CandyFarm.Enabled then break end
			if Library.WorldCmds.Get() ~= CurrentWorldIdentifier then break end

			Settings.CandyFarm.CurrentArea = ZoneData.name
			UpdateLabel(Labels.Area, ZoneData.name .. " (" .. ZoneIndex .. "/" .. #OrderedZones .. ")")
			task.wait(0.5)

			local IdleTimer = 0
			while Settings.CandyFarm.Enabled and (Library.WorldCmds.Get() == CurrentWorldIdentifier) do
				local CandiesFound = {}
				for _, CoinNode in ipairs(CoinsFolder:GetChildren()) do
					if CoinScanner.IsCandyCane(CoinNode) then
						local PositionPart = CoinNode:FindFirstChild("POS")
						local AssignedZone = CoinNode:GetAttribute("Area")
						if (AssignedZone and string.lower(AssignedZone) == string.lower(ZoneData.name)) or (PositionPart and (PositionPart.Position - ZoneData.position).Magnitude <= 190) then
							table.insert(CandiesFound, CoinNode)
						end
					end
				end

				if #CandiesFound > 0 then
					IdleTimer = 0
					local AvailablePets = PetOperations.GetEquippedIds()
					if #AvailablePets > 0 then
						for Index = 1, math.min(#AvailablePets, #CandiesFound) do
							if not Settings.CandyFarm.Enabled then break end
							local TargetCoin = CandiesFound[Index]
							local TargetPet = AvailablePets[Index]
							if TargetCoin and TargetCoin.Parent and TargetPet then
								PetOperations.AssignPets(TargetCoin, { TargetPet })
								task.wait(0.5)
							end
						end
					end

					local TimeoutClock = os.clock()
					while Settings.CandyFarm.Enabled and #CandiesFound > 0 and (os.clock() - TimeoutClock < 3.5) do
						task.wait(0.5)
						local Remaining = {}
						for _, CoinEntry in ipairs(CandiesFound) do
							if CoinEntry and CoinEntry.Parent == CoinsFolder then
								table.insert(Remaining, CoinEntry)
							end
						end
						CandiesFound = Remaining
					end
				else
					IdleTimer = IdleTimer + 1
					if IdleTimer >= Settings.CandyFarm.EmptyTimeout then
						break
					end
					task.wait(1)
				end
			end
			task.wait(0.5)
		end
	end
end)

