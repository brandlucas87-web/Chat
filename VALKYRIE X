	end
end)

Library.Network.Fired("Open Egg"):Connect(function(EggId, HatchedPets)
	if type(HatchedPets) == "table" then
		local SaveData = Library.Save.Get()
		local AutoDeleteConfig = SaveData and SaveData.Settings and SaveData.Settings.AutoDelete
		if AutoDeleteConfig then
			local DeleteList = {}
			for _, PetEntry in ipairs(HatchedPets) do
				if PetEntry and PetEntry.id and PetEntry.uid then
					local DirectoryData = Library.Directory.Pets[PetEntry.id]
					if DirectoryData and DirectoryData.rarity then
						local RarityString = tostring(DirectoryData.rarity)
						if AutoDeleteConfig[RarityString] then
							table.insert(DeleteList, tostring(PetEntry.uid))
						end
					end
				end
			end
			if #DeleteList > 0 then
				task.spawn(function()
					pcall(function()
						Library.Network.Invoke("Delete Several Pets", DeleteList)
					end)
				end)
			end
		end
	end
end)
