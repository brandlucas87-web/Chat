			end

			if LootbagsFolder then
				for _, Bag in ipairs(LootbagsFolder:GetChildren()) do
					SuppressLootbag(Bag)
				end

				local LootbagConn = LootbagsFolder.ChildAdded:Connect(function(NewBag)
					task.defer(function()
						SuppressLootbag(NewBag)
						local SubConn = NewBag.DescendantAdded:Connect(function(SubItem)
							task.defer(function()
								if SubItem:IsA("BasePart") then
									SubItem.Transparency = 1
									SubItem.CastShadow = false
								elseif SubItem:IsA("ParticleEmitter") or SubItem:IsA("Trail") or SubItem:IsA("Beam") or SubItem:IsA("BillboardGui") or SubItem:IsA("PointLight") or SubItem:IsA("Highlight") then
									SubItem.Enabled = false
								end
							end)
						end)
						table.insert(ActiveConnections, SubConn)
					end)
				end)
				table.insert(ActiveConnections, LootbagConn)
			end

			if Library.WorldFX then
				Library.WorldFX.CoinSelection = function()
					return function() end
				end
				Library.WorldFX.ModelFlash = function() end
				Library.WorldFX.AddCurrency = function() end
				Library.WorldFX.QuestGlow = function()
					return function() end
				end
			end

			if Library.GUIParticles then
				Library.GUIParticles.New = function()
					return Instance.new("ParticleEmitter")
				end
			end

			if ParticlesFolder then
				for _, Emitter in ipairs(ParticlesFolder:GetDescendants()) do
					if Emitter:IsA("ParticleEmitter") then
						if OriginalParticleTemplates[Emitter] == nil then
							OriginalParticleTemplates[Emitter] = Emitter.Enabled
						end
						Emitter.Enabled = false
					end
				end
			end

			if CoinParticleModel and CoinParticleModel:IsA("BasePart") then
				CoinParticleModel.Transparency = 1
				CoinParticleModel.CastShadow = false
			end

			if DebrisFolder then
				for _, Item in ipairs(DebrisFolder:GetChildren()) do
					if Item.Name == "Coin Particle" or Item.Name == "host" or Item.Name == "Explosion FX" then
						pcall(function() Item:Destroy() end)
					else
						StripInstance(Item)
					end
				end

				local DebrisConn = DebrisFolder.ChildAdded:Connect(function(Child)
					task.defer(function()
						if Child.Name == "Coin Particle" or Child.Name == "host" or Child.Name == "Explosion FX" then
							pcall(function() Child:Destroy() end)
						else
							StripInstance(Child)
						end
					end)
				end)
				table.insert(ActiveConnections, DebrisConn)
			end
		else
			if Library.WorldFX then
				if OriginalCoinSelection then Library.WorldFX.CoinSelection = OriginalCoinSelection end
				if OriginalModelFlash then Library.WorldFX.ModelFlash = OriginalModelFlash end
				if OriginalAddCurrency then Library.WorldFX.AddCurrency = OriginalAddCurrency end
				if OriginalQuestGlow then Library.WorldFX.QuestGlow = OriginalQuestGlow end
			end

			if Library.GUIParticles and OriginalGUIParticlesNew then
				Library.GUIParticles.New = OriginalGUIParticlesNew
			end

			for Emitter, WasEnabled in pairs(OriginalParticleTemplates) do
				if typeof(Emitter) == "Instance" and Emitter.Parent then
					pcall(function() Emitter.Enabled = WasEnabled end)
				end
			end
			table.clear(OriginalParticleTemplates)

			if CoinParticleModel and CoinParticleModel:IsA("BasePart") then
				CoinParticleModel.Transparency = 0
			end

			if Lighting then
				if OriginalLighting.GlobalShadows ~= nil then
					Lighting.GlobalShadows = OriginalLighting.GlobalShadows
				end
				if OriginalLighting.FogEnd ~= nil then
					Lighting.FogEnd = OriginalLighting.FogEnd
				end
				for Effect, WasEnabled in pairs(OriginalLighting) do
					if typeof(Effect) == "Instance" and Effect.Parent then
						pcall(function() Effect.Enabled = WasEnabled end)
					end
				end
				table.clear(OriginalLighting)
			end

			if Terrain then
				if OriginalTerrain.WaterWaveSize ~= nil then
