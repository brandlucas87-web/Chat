			end

			for TargetInstance, Props in pairs(OriginalProperties) do
				if TargetInstance and TargetInstance.Parent then
					pcall(function()
						if Props.Material then TargetInstance.Material = Props.Material end
						if Props.CastShadow ~= nil then TargetInstance.CastShadow = Props.CastShadow end
						if Props.Transparency ~= nil then TargetInstance.Transparency = Props.Transparency end
						if Props.Enabled ~= nil then TargetInstance.Enabled = Props.Enabled end
					end)
				end
			end
			table.clear(OriginalProperties)

			if OrbsFolder then
				for _, Orb in ipairs(OrbsFolder:GetChildren()) do
					if Orb:IsA("BasePart") then
						Orb.Transparency = 0
						Orb.CastShadow = true
