					for _, Sub in ipairs(Orb:GetDescendants()) do
						if Sub:IsA("BasePart") then
							Sub.Transparency = 0
							Sub.CastShadow = true
						elseif Sub:IsA("ParticleEmitter") or Sub:IsA("Trail") or Sub:IsA("Beam") then
