	local function StripInstance(InstanceObj)
		if not Settings.Performance.FPSBoost then return end

		if InstanceObj:IsA("BasePart") then
			if not OriginalProperties[InstanceObj] then
				OriginalProperties[InstanceObj] = {
					Material = InstanceObj.Material,
					CastShadow = InstanceObj.CastShadow
				}
			end
			InstanceObj.Material = Enum.Material.SmoothPlastic
			InstanceObj.CastShadow = false
		elseif InstanceObj:IsA("Decal") or InstanceObj:IsA("Texture") then
			if not OriginalProperties[InstanceObj] then
				OriginalProperties[InstanceObj] = {
					Transparency = InstanceObj.Transparency
				}
			end
			InstanceObj.Transparency = 1
		elseif InstanceObj:IsA("ParticleEmitter") or InstanceObj:IsA("Trail") or InstanceObj:IsA("Beam") or InstanceObj:IsA("Fire") or InstanceObj:IsA("Smoke") or InstanceObj:IsA("Sparkles") then
			if not OriginalProperties[InstanceObj] then
				OriginalProperties[InstanceObj] = {
					Enabled = InstanceObj.Enabled
				}
			end
			InstanceObj.Enabled = false
		elseif InstanceObj:IsA("PostEffect") then
			if not OriginalProperties[InstanceObj] then
				OriginalProperties[InstanceObj] = {
					Enabled = InstanceObj.Enabled
				}
			end
			InstanceObj.Enabled = false
		end
	end

	local function SuppressOrb(OrbEntity)
		if not Settings.Performance.FPSBoost then return end

		if OrbEntity:IsA("BasePart") then
			OrbEntity.Transparency = 1
			OrbEntity.CastShadow = false
		end

		for _, Child in ipairs(OrbEntity:GetDescendants()) do
			if Child:IsA("BasePart") then
				Child.Transparency = 1
				Child.CastShadow = false
			elseif Child:IsA("ParticleEmitter") or Child:IsA("Trail") or Child:IsA("Beam") then
				Child.Enabled = false
			elseif Child:IsA("BillboardGui") or Child:IsA("SurfaceGui") or Child:IsA("PointLight") then
				Child.Enabled = false
			end
		end
	end

	local function SuppressLootbag(BagEntity)
		if not Settings.Performance.FPSBoost then return end

		if BagEntity:IsA("BasePart") then
			BagEntity.Transparency = 1
			BagEntity.CastShadow = false
		end

		for _, Child in ipairs(BagEntity:GetDescendants()) do
			if Child:IsA("BasePart") then
				Child.Transparency = 1
				Child.CastShadow = false
			elseif Child:IsA("ParticleEmitter") or Child:IsA("Trail") or Child:IsA("Beam") then
				Child.Enabled = false
			elseif Child:IsA("BillboardGui") or Child:IsA("SurfaceGui") or Child:IsA("PointLight") or Child:IsA("Highlight") then
				Child.Enabled = false
			end
		end

		local BagConn = BagEntity.DescendantAdded:Connect(function(SubItem)
			task.defer(function()
				if SubItem:IsA("BasePart") then
					SubItem.Transparency = 1
					SubItem.CastShadow = false
				elseif SubItem:IsA("ParticleEmitter") or SubItem:IsA("Trail") or SubItem:IsA("Beam") or SubItem:IsA("BillboardGui") or SubItem:IsA("SurfaceGui") or SubItem:IsA("PointLight") or SubItem:IsA("Highlight") then
					SubItem.Enabled = false
				end
			end)
		end)
		table.insert(ActiveConnections, BagConn)
	end

	function PerformanceManager.SetFPSBoost(State)
		for _, Connection in ipairs(ActiveConnections) do
			pcall(function() Connection:Disconnect() end)
		end
		table.clear(ActiveConnections)

		if setfpscap then
			pcall(setfpscap, 60)
		end

