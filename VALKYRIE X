			if Lighting then
				OriginalLighting.GlobalShadows = Lighting.GlobalShadows
				OriginalLighting.FogEnd = Lighting.FogEnd
				Lighting.GlobalShadows = false
				Lighting.FogEnd = 9e9

				for _, Effect in ipairs(Lighting:GetChildren()) do
					if Effect:IsA("PostEffect") then
						if OriginalLighting[Effect] == nil then
							OriginalLighting[Effect] = Effect.Enabled
						end
						Effect.Enabled = false
					end
				end

				local LightingConn = Lighting.ChildAdded:Connect(function(Child)
					if Child:IsA("PostEffect") then
						Child.Enabled = false
					end
				end)
				table.insert(ActiveConnections, LightingConn)
			end

			if Terrain then
				OriginalTerrain.WaterWaveSize = Terrain.WaterWaveSize
				OriginalTerrain.WaterWaveSpeed = Terrain.WaterWaveSpeed
				OriginalTerrain.WaterReflectance = Terrain.WaterReflectance
				OriginalTerrain.WaterTransparency = Terrain.WaterTransparency

				Terrain.WaterWaveSize = 0
				Terrain.WaterWaveSpeed = 0
				Terrain.WaterReflectance = 0
				Terrain.WaterTransparency = 0
			end

			for _, Descendant in ipairs(workspace:GetDescendants()) do
				StripInstance(Descendant)
			end

			local WorkspaceConn = workspace.DescendantAdded:Connect(function(NewDescendant)
				task.defer(function()
					StripInstance(NewDescendant)
				end)
			end)
			table.insert(ActiveConnections, WorkspaceConn)

			if OrbsFolder then
				for _, Orb in ipairs(OrbsFolder:GetChildren()) do
					SuppressOrb(Orb)
				end

				local OrbConn = OrbsFolder.ChildAdded:Connect(function(NewOrb)
					task.defer(function()
						SuppressOrb(NewOrb)
						local SubConn = NewOrb.DescendantAdded:Connect(function(SubItem)
							task.defer(function()
								if SubItem:IsA("BasePart") then
									SubItem.Transparency = 1
									SubItem.CastShadow = false
								elseif SubItem:IsA("ParticleEmitter") or SubItem:IsA("Trail") or SubItem:IsA("Beam") or SubItem:IsA("BillboardGui") or SubItem:IsA("PointLight") then
									SubItem.Enabled = false
