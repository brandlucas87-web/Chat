							break
						end
						task.wait()
					end
				end

				if IncompletePets == 0 then
					UpdateLabel(Labels.EnchantStatus, "Todos os pets equipados possuem " .. SelectedPower .. "!")
					task.wait(1)
				end
			end
		else
